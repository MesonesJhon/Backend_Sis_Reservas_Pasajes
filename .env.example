APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=backend_reservas
DB_USERNAME=root
DB_PASSWORD=

# =========================================================
# MERCADO PAGO
# =========================================================

MERCADOPAGO_BASE_URL=https://api.mercadopago.com

# Tú colocas aquí el Access Token DE PRUEBA.
# No compartir ni subir a GitHub.
MERCADOPAGO_ACCESS_TOKEN=TU_ACCESS_TOKEN_DE_PRUEBA


# Se obtiene más adelante al configurar Webhooks.
MERCADOPAGO_WEBHOOK_SECRET=


# Nombre de la empresa/sistema durante desarrollo.
MERCADOPAGO_COMPANY="Reservas Pasajes"


# ---------------------------------------------------------
# WEB
# ---------------------------------------------------------
#
# Las configuraremos cuando expongamos Vue mediante HTTPS.
#

MERCADOPAGO_WEB_SUCCESS_URL=
MERCADOPAGO_WEB_FAILURE_URL=
MERCADOPAGO_WEB_PENDING_URL=


# ---------------------------------------------------------
# MOBILE
# ---------------------------------------------------------
#
# Deep Links provisionales de nuestra futura aplicación.
#

MERCADOPAGO_MOBILE_SUCCESS_URL=reservapasajes://pagos/success
MERCADOPAGO_MOBILE_FAILURE_URL=reservapasajes://pagos/failure
MERCADOPAGO_MOBILE_PENDING_URL=reservapasajes://pagos/pending

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
